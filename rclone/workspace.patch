+func init() {
+	rc.Add(rc.Call{
+		Path:  "vfs/status",
+		Title: "Show the pin and cache status of a directory's entries.",
+		Help: strings.ReplaceAll(`
+
+This lists the entries of the directory |path|, or just |path| if it is
+a file.
+
+This takes the following parameters
+
+- |path| - file or directory, relative to the VFS root
+
+This returns
+
+- |pin_budget_left| - bytes which can still be pinned, -1 if unlimited
+- |files| - list of entries, each with
+    - |name| - leaf name
+    - |pinned| - true if pinned, directly or via a parent
+    - |cached| - files only, true if fully cached
+    - |size| - files only, size in bytes
+    - |failed| - files only, true if pinned but the last download failed
+    - |releasing| - files only, true if waiting to be evicted by |vfs/evict|
+    - |mixed| - directories only, true if something inside has a
+      different pin mode
+
+`, "|", "`") + getVFSHelp,
+		Fn: rcStatus,
+	})
+}
+
+func rcStatus(ctx context.Context, in rc.Params) (out rc.Params, err error) {
+	vfs, err := getVFS(in)
+	if err != nil {
+		return nil, err
+	}
+	if vfs.cache == nil {
+		return nil, rc.NewErrParamInvalid(errors.New("can't call this unless using the VFS cache"))
+	}
+
+	path, err := in.GetString("path")
+	if err != nil {
+		return nil, err
+	}
+	node, err := vfs.Stat(path)
+	if err != nil {
+		return nil, err
+	}
+	nodes := Nodes{node}
+	if node.IsDir() {
+		if nodes, err = node.(*Dir).ReadDirAll(); err != nil {
+			return nil, err
+		}
+	}
+
+	files := []rc.Params{}
+	for _, n := range nodes {
+		pinned := vfs.cache.PinMode(n.Path()) == vfscache.PinModePinned
+		entry := rc.Params{"name": n.Name(), "pinned": pinned}
+		if n.IsDir() {
+			entry["mixed"] = vfs.cache.Mixed(n.Path())
+		} else {
+			cached := vfs.cache.Present(n.Path(), n.Size())
+			entry["cached"] = cached
+			entry["size"] = n.Size()
+			entry["failed"] = pinned && !cached && vfs.cache.PinFailed(n.Path())
+			entry["releasing"] = vfs.cache.Releasing(n.Path())
+		}
+		files = append(files, entry)
+	}
+	return rc.Params{"files": files, "pin_budget_left": vfs.cache.PinBudgetLeft()}, nil
+}
+
