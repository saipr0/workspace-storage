+func TestPinSaveFailure(t *testing.T) {
+	_, c := newTestCache(t)
+	for _, action := range []string{"unpin", "evict", "rename", "remove", "reserve"} {
+		t.Run(action, func(t *testing.T) {
+			require.NoError(t, c.PinReserve([]string{"keep"}, map[string]int64{"keep": 60}))
+			before := c.clonePins()
+			disk, err := os.ReadFile(c.pinsPath())
+			require.NoError(t, err)
+			require.NoError(t, os.Mkdir(c.pinsPath()+".tmp", 0700))
+			t.Cleanup(func() { require.NoError(t, os.Remove(c.pinsPath()+".tmp")) })
+			switch action {
+			case "unpin":
+				err = c.SetPin("keep", PinModeUnpinned)
+			case "evict":
+				_, err = c.Evict("keep")
+			case "rename":
+				err = c.RenamePins("keep", "moved")
+			case "remove":
+				err = c.RemovePins("keep")
+			case "reserve":
+				err = c.PinReserve([]string{"other"}, map[string]int64{"other": 60})
+			}
+			require.Error(t, err)
+			assert.Equal(t, before, c.pins)
+			after, err := os.ReadFile(c.pinsPath())
+			require.NoError(t, err)
+			assert.Equal(t, disk, after)
+		})
+	}
+}
