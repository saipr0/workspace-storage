+func TestPinBudgetRenameAndUnpin(t *testing.T) {
+	opt := vfscommon.Opt
+	opt.CachePollInterval = 0
+	opt.CacheMaxSize = 100
+	_, c := newTestCacheOpt(t, opt)
+	require.NoError(t, c.PinReserve([]string{"dir"}, map[string]int64{"dir/a": 60}))
+	require.NoError(t, c.RenamePins("dir/a", "dir/b"))
+	assert.Equal(t, map[string]int64{"dir/b": 60}, c.pins.Sizes)
+	require.NoError(t, c.RemovePins("dir/b"))
+	assert.Equal(t, int64(100), c.PinBudgetLeft())
+	require.NoError(t, c.PinReserve(nil, map[string]int64{"dir/c": 60}))
+	require.NoError(t, c.SetPin("dir/c", PinModeUnpinned))
+	assert.Equal(t, int64(100), c.PinBudgetLeft())
+	// A retry of the parent must respect unpinned children.
+	require.NoError(t, c.PinReserve(nil, map[string]int64{"dir/c": 60}))
+	assert.Empty(t, c.pins.Sizes)
+}
