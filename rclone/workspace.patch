+func TestPendingColdFollowsRename(t *testing.T) {
+	opt := vfscommon.Opt
+	opt.CachePollInterval = 0
+	opt.HandleCaching = 0
+	_, c := newTestCacheOpt(t, opt)
+	item := c.Item("before")
+	require.NoError(t, item.Open(nil))
+	_, err := c.Evict("before")
+	require.NoError(t, err)
+	require.True(t, c.Releasing("before"))
+	require.NoError(t, c.Rename("before", "after", nil))
+	assert.True(t, c.Releasing("after"))
+	assert.False(t, c.Releasing("before"))
+	require.NoError(t, item.Close(nil))
+	c.purgeOld(time.Hour)
+	assert.Empty(t, itemAsString(c))
+}
