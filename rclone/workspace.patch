diff --git a/vfs/vfscache/workspace.go b/vfs/vfscache/workspace.go
new file mode 100644
index 0000000..efd8258
--- /dev/null
+++ b/vfs/vfscache/workspace.go
@@ -0,0 +1,437 @@
+package vfscache
+
+// Workspace policy lives outside the expendable VFS metadata tree. Lock order:
+// Cache.mu -> Item.mu -> workspaceMu. Never acquire a cache/item lock while
+// holding workspaceMu. A failed state write rolls back the in-memory change.
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"github.com/rclone/rclone/lib/diskusage"
+)
+
+type WorkspaceState struct {
+	Version int               `json:"version"`
+	Budget  int64             `json:"budget"`
+	Pins    map[string]bool   `json:"pins"`
+	Jobs    map[string]string `json:"jobs"`
+	Moves   map[string]string `json:"moves,omitempty"`
+}
+
+type WorkspaceFile struct {
+	Complete bool  `json:"complete"`
+	Cached   int64 `json:"cached"`
+	Size     int64 `json:"size"`
+	Dirty    bool  `json:"dirty"`
+	Busy     bool  `json:"busy"`
+	Pinned   bool  `json:"pinned"`
+}
+
+type workspacePolicy struct {
+	mu     sync.Mutex
+	state  WorkspaceState
+	leases map[string]int
+	file   string
+}
+
+func WorkspacePath(name string) (string, error) {
+	if strings.ContainsAny(name, "\\\x00") || strings.HasPrefix(name, "/") {
+		return "", errors.New("workspace paths must be relative")
+	}
+	for _, part := range strings.Split(name, "/") {
+		if part == ".." {
+			return "", errors.New("parent traversal is forbidden")
+		}
+	}
+	name = path.Clean(name)
+	if name == "." {
+		name = ""
+	}
+	return name, nil
+}
+
+func (c *Cache) loadWorkspace() error {
+	c.workspace.file = c.metaRoot + ".workspace.json"
+	c.workspace.leases = make(map[string]int)
+	c.workspace.state = WorkspaceState{Version: 1, Budget: 0, Pins: map[string]bool{}, Jobs: map[string]string{}}
+	b, err := os.ReadFile(c.workspace.file)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if err = json.Unmarshal(b, &c.workspace.state); err != nil {
+		return fmt.Errorf("invalid workspace state: %w", err)
+	}
+	if c.workspace.state.Version != 1 || c.workspace.state.Pins == nil || c.workspace.state.Jobs == nil {
+		return errors.New("unsupported workspace state")
+	}
+	return nil
+}
+
+func cloneWorkspace(s WorkspaceState) WorkspaceState {
+	n := s
+	n.Pins = make(map[string]bool, len(s.Pins))
+	n.Jobs = make(map[string]string, len(s.Jobs))
+	n.Moves = make(map[string]string, len(s.Moves))
+	for k, v := range s.Moves {
+		n.Moves[k] = v
+	}
+	for k, v := range s.Pins {
+		n.Pins[k] = v
+	}
+	for k, v := range s.Jobs {
+		n.Jobs[k] = v
+	}
+	return n
+}
+
+func (c *Cache) WorkspaceState() WorkspaceState {
+	c.workspace.mu.Lock()
+	defer c.workspace.mu.Unlock()
+	state := cloneWorkspace(c.workspace.state)
+	if state.Budget == 0 {
+		state.Budget = int64(c.opt.CacheMaxSize)
+	}
+	return state
+}
+
+func (c *Cache) changeWorkspace(fn func(*WorkspaceState)) error {
+	c.workspace.mu.Lock()
+	defer c.workspace.mu.Unlock()
+	next := cloneWorkspace(c.workspace.state)
+	fn(&next)
+	b, err := json.Marshal(next)
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(filepath.Dir(c.workspace.file), ".workspace-*")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if _, err = f.Write(b); err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	if err = os.Rename(name, c.workspace.file); err != nil {
+		return err
+	}
+	// The rename has committed. Keep memory consistent even if directory fsync fails.
+	c.workspace.state = next
+	dir, err := os.Open(filepath.Dir(c.workspace.file))
+	if err != nil {
+		return err
+	}
+	defer dir.Close()
+	return dir.Sync()
+}
+
+func (c *Cache) WorkspaceRequest(name, action string) error {
+	var err error
+	if name, err = WorkspacePath(name); err != nil {
+		return err
+	}
+	return c.changeWorkspace(func(s *WorkspaceState) {
+		switch action {
+		case "pin":
+			s.Pins[name] = true
+			s.Jobs[name] = "warm"
+		case "cold":
+			s.Pins[name] = false
+			s.Jobs[name] = "cold"
+		case "warm":
+			s.Jobs[name] = "warm"
+		case "auto":
+			s.Pins[name] = false
+			delete(s.Jobs, name)
+		case "inherit":
+			delete(s.Pins, name)
+			delete(s.Jobs, name)
+		case "cancel":
+			s.Pins[name] = false
+			delete(s.Jobs, name)
+		}
+	})
+}
+
+func (c *Cache) WorkspaceFinish(name, action string) error {
+	return c.changeWorkspace(func(s *WorkspaceState) {
+		if s.Jobs[name] == action {
+			delete(s.Jobs, name)
+		}
+	})
+}
+
+func (c *Cache) WorkspaceBudget(budget int64) error {
+	if budget <= 0 {
+		return errors.New("budget must be positive")
+	}
+	return c.changeWorkspace(func(s *WorkspaceState) { s.Budget = budget })
+}
+
+func (c *Cache) workspaceLimit() int64 {
+	c.workspace.mu.Lock()
+	defer c.workspace.mu.Unlock()
+	if c.workspace.state.Budget == 0 {
+		return int64(c.opt.CacheMaxSize)
+	}
+	return c.workspace.state.Budget
+}
+
+func pinned(s WorkspaceState, name string) bool {
+	for {
+		if v, found := s.Pins[name]; found {
+			return v
+		}
+		if name == "" {
+			return false
+		}
+		name = path.Dir(name)
+		if name == "." {
+			name = ""
+		}
+	}
+}
+
+func (c *Cache) WorkspacePinned(name string) bool {
+	c.workspace.mu.Lock()
+	defer c.workspace.mu.Unlock()
+	return protectedPin(c.workspace.state, name)
+}
+
+func (c *Cache) workspaceProtected(name string) bool {
+	c.workspace.mu.Lock()
+	defer c.workspace.mu.Unlock()
+	return protectedPin(c.workspace.state, name) || c.workspace.leases[name] > 0
+}
+
+// A lease prevents the cleaner from discarding chunks while a whole-file warm
+// is in progress. It is not a pin and does not survive process termination.
+func (c *Cache) WorkspaceLease(name string) func() {
+	c.workspace.mu.Lock()
+	c.workspace.leases[name]++
+	c.workspace.mu.Unlock()
+	return func() { c.workspace.mu.Lock(); c.workspace.leases[name]--; c.workspace.mu.Unlock() }
+}
+
+func (c *Cache) WorkspaceStatus(name string) WorkspaceFile {
+	s := WorkspaceFile{Pinned: c.WorkspacePinned(name)}
+	c.mu.Lock()
+	item := c.item[name]
+	c.mu.Unlock()
+	if item == nil {
+		return s
+	}
+	item.mu.Lock()
+	defer item.mu.Unlock()
+	s.Size = item.info.Size
+	s.Cached = item.info.Rs.Size()
+	s.Complete = item._exists() && item._present()
+	s.Dirty = item.info.Dirty
+	s.Busy = item.opens != 0 || item.graceTimer != nil
+	return s
+}
+
+func (c *Cache) WorkspaceEvict(name string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	item := c.item[name]
+	if item == nil {
+		return nil
+	}
+	item.mu.Lock()
+	defer item.mu.Unlock()
+	if c.workspaceProtected(name) {
+		return errors.New("file is pinned or downloading")
+	}
+	if item.info.Dirty {
+		return errors.New("waiting for cloud upload")
+	}
+	if item.opens != 0 || item.graceTimer != nil {
+		return errors.New("waiting for file to close")
+	}
+	item._removeFile("workspace make cold")
+	if item._exists() {
+		return errors.New("could not remove local cache file")
+	}
+	item._removeMeta("workspace make cold")
+	item.info.clean()
+	delete(c.item, name)
+	return nil
+}
+
+// Reserve room for a whole-file download, reclaiming only clean unprotected
+// cache entries. Uploads retain rclone's existing soft-limit semantics.
+func (c *Cache) WorkspaceAdmit(name string, size int64) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	var used, missing int64
+	missing = size
+	for key, item := range c.item {
+		item.mu.Lock()
+		cached := item.info.Rs.Size()
+		item.mu.Unlock()
+		used += cached
+		if key == name {
+			missing -= cached
+		}
+	}
+	if missing < 0 {
+		missing = 0
+	}
+	limit := c.workspaceLimit()
+	if limit > 0 && used+missing > limit {
+		for key, item := range c.item {
+			if key == name {
+				continue
+			}
+			removed, freed := item.RemoveNotInUse(0, false)
+			if removed {
+				delete(c.item, key)
+				used -= freed
+			}
+			if used+missing <= limit {
+				break
+			}
+		}
+		if used+missing > limit {
+			return errors.New("local budget is occupied; unpin files or increase the budget")
+		}
+	}
+	du, err := diskusage.New(c.root)
+	if err == nil && int64(du.Available)-missing < int64(c.opt.CacheMinFreeSpace) {
+		return errors.New("insufficient disk space after the free-space reserve")
+	}
+	if err != nil && err != diskusage.ErrUnsupported {
+		return err
+	}
+	return nil
+}
+
+func within(name, parent string) bool {
+	return name == parent || parent == "" || strings.HasPrefix(name, parent+"/")
+}
+
+// Called after VFS mutations, including writes from native clients. Policy is
+// keyed to the VFS namespace, never to browser-supplied filesystem paths.
+func (c *Cache) WorkspaceRename(oldName, newName string) error {
+	if oldName == newName {
+		return c.WorkspaceAbortRename(oldName)
+	}
+	return c.changeWorkspace(func(s *WorkspaceState) {
+		delete(s.Moves, oldName)
+		for k := range s.Pins {
+			if within(k, newName) {
+				delete(s.Pins, k)
+			}
+		}
+		for k := range s.Jobs {
+			if within(k, newName) {
+				delete(s.Jobs, k)
+			}
+		}
+		for k, v := range cloneWorkspace(*s).Pins {
+			if within(k, oldName) {
+				delete(s.Pins, k)
+				s.Pins[newName+strings.TrimPrefix(k, oldName)] = v
+			}
+		}
+		for k, v := range cloneWorkspace(*s).Jobs {
+			if within(k, oldName) {
+				delete(s.Jobs, k)
+				s.Jobs[newName+strings.TrimPrefix(k, oldName)] = v
+			}
+		}
+	})
+}
+
+func (c *Cache) WorkspaceDelete(name string) error {
+	return c.changeWorkspace(func(s *WorkspaceState) {
+		for k := range s.Pins {
+			if within(k, name) {
+				delete(s.Pins, k)
+			}
+		}
+		for k := range s.Jobs {
+			if within(k, name) {
+				delete(s.Jobs, k)
+			}
+		}
+	})
+}
+
+func (c *Cache) WorkspaceUploadState(name string) (uploading bool, retries int) {
+	for _, entry := range c.writeback.Queue() {
+		if within(entry.Name, name) {
+			uploading = uploading || entry.Uploading
+			if !entry.Uploading && entry.Tries > retries {
+				retries = entry.Tries
+			}
+		}
+	}
+	return
+}
+
+// WorkspacePendingUploads includes open writes not yet in the writeback queue.
+func (c *Cache) WorkspacePendingUploads() []string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	names := []string{}
+	for name, item := range c.item {
+		item.mu.Lock()
+		if item.info.Dirty {
+			names = append(names, name)
+		}
+		item.mu.Unlock()
+	}
+	return names
+}
+
+// WorkspaceCancelDownloads persists a batch without changing upload state.
+func (c *Cache) WorkspaceCancelDownloads(names []string) error {
+	return c.changeWorkspace(func(s *WorkspaceState) {
+		for _, name := range names {
+			s.Pins[name] = false
+			delete(s.Jobs, name)
+		}
+	})
+}
+
+// Preserve protection at both names until a filesystem rename is committed.
+func protectedPin(s WorkspaceState, name string) bool {
+	if pinned(s, name) {
+		return true
+	}
+	for old, next := range s.Moves {
+		if within(name, next) && pinned(s, old+strings.TrimPrefix(name, next)) {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *Cache) WorkspacePrepareRename(old, next string) error {
+	if old == next {
+		return nil
+	}
+	return c.changeWorkspace(func(s *WorkspaceState) { s.Moves[old] = next })
+}
+
+func (c *Cache) WorkspaceAbortRename(old string) error {
+	return c.changeWorkspace(func(s *WorkspaceState) { delete(s.Moves, old) })
+}
