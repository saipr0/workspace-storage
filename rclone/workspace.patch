+func rcRetry(ctx context.Context, in rc.Params) (out rc.Params, err error) {
+	vfs, err := getVFS(in)
+	if err != nil {
+		return nil, err
+	}
+	if vfs.cache == nil {
+		return nil, rc.NewErrParamInvalid(errors.New("can't call this unless using the VFS cache"))
+	}
+
+	path, err := in.GetString("path")
+	if err != nil {
+		return nil, err
+	}
+	if vfs.cache.PinMode(path) != vfscache.PinModePinned {
+		return nil, rc.NewErrParamInvalid(fmt.Errorf("%q is not pinned", path))
+	}
+	return nil, vfs.pinAndWarm(nil, []string{path})
+}
