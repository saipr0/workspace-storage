+func TestPinBudgetDuringWarm(t *testing.T) {
+	opt := vfscommon.Opt
+	opt.CachePollInterval = 0
+	opt.CacheMaxSize = 100
+	_, c := newTestCacheOpt(t, opt)
+	err := c.PinReserve([]string{"a"}, map[string]int64{"a": 60})
+	require.NoError(t, err)
+	item := c.Item("a")
+	item.mu.Lock()
+	item.info.Size = 60
+	item.info.Rs.Insert(ranges.Range{Pos: 0, Size: 30})
+	item.mu.Unlock()
+	assert.Equal(t, int64(40), c.PinBudgetLeft())
+	err = c.PinReserve([]string{"b"}, map[string]int64{"b": 40})
+	require.NoError(t, err)
+	assert.Zero(t, c.PinBudgetLeft())
+	// Retrying a partial download must not count it twice.
+	err = c.PinReserve([]string{"a"}, map[string]int64{"a": 60})
+	require.NoError(t, err)
+	assert.Zero(t, c.PinBudgetLeft())
+	require.NoError(t, c.SetPin("a", PinModeUnpinned))
+	assert.Equal(t, int64(60), c.PinBudgetLeft())
+	require.NoError(t, c.SetPin("b", PinModeUnpinned))
+	assert.Equal(t, int64(100), c.PinBudgetLeft())
+}
