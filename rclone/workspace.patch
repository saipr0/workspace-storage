index 000000000..189e5df2a
--- /dev/null
+++ b/vfs/pin_test.go
@@ -0,0 +1,100 @@
+package vfs
+
+import (
+	"context"
+	"errors"
+	"io"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/vfs/vfscommon"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPinCacheModeChange(t *testing.T) {
+	opt := vfscommon.Opt
+	opt.CacheMode = vfscommon.CacheModeFull
+	opt.CachePollInterval = 0
+	_, v := newTestVFSOpt(t, &opt)
+	for range 30 {
+		v.SetCacheMode(vfscommon.CacheModeOff)
+		v.SetCacheMode(vfscommon.CacheModeFull)
+	}
+}
+
+type pinRemoveFailure struct{ fs.Object }
+
+func (pinRemoveFailure) Remove(context.Context) error {
+	return errors.New("backend delete failure")
+}
+
+func TestFailedRemovePreservesPin(t *testing.T) {
+	opt := vfscommon.Opt
+	opt.CacheMode = vfscommon.CacheModeFull
+	opt.CachePollInterval = 0
+	r, v := newTestVFSOpt(t, &opt)
+	r.WriteObject(context.Background(), "keep", "content", t1)
+	n, err := v.Stat("keep")
+	require.NoError(t, err)
+	f := n.(*File)
+	f.mu.Lock()
+	original := f.o
+	f.o = pinRemoveFailure{original}
+	f.mu.Unlock()
+	require.NoError(t, v.cache.SetPin("keep", "pinned"))
+	require.Error(t, f.Remove())
+	assert.EqualValues(t, "pinned", v.cache.PinMode("keep"))
+	f.mu.Lock()
+	f.o = original
+	f.mu.Unlock()
+	require.NoError(t, f.Remove())
+	assert.EqualValues(t, "unpinned", v.cache.PinMode("keep"))
+}
+
+type pinBlockingOpen struct {
+	fs.Object
+	started chan struct{}
+}
+
+func (o pinBlockingOpen) Open(ctx context.Context, options ...fs.OpenOption) (io.ReadCloser, error) {
+	select {
+	case o.started <- struct{}{}:
+	default:
+	}
+	<-ctx.Done()
+	return nil, ctx.Err()
+}
+
+func TestPinWarmCacheModeChange(t *testing.T) {
+	opt := vfscommon.Opt
+	opt.CacheMode = vfscommon.CacheModeFull
+	opt.CachePollInterval = 0
+	opt.CacheMaxSize = 100
+	r, v := newTestVFSOpt(t, &opt)
+	r.WriteObject(context.Background(), "keep", "content", t1)
+	n, err := v.Stat("keep")
+	require.NoError(t, err)
+	f := n.(*File)
+	started := make(chan struct{}, 1)
+	f.mu.Lock()
+	original := f.o
+	f.o = pinBlockingOpen{original, started}
+	f.mu.Unlock()
+	cache := v.cache
+	require.NoError(t, v.pinAndWarm([]string{"keep"}, []string{"keep"}))
+	select {
+	case <-started:
+	case <-time.After(5 * time.Second):
+		t.Fatal("warm did not start")
+	}
+	v.SetCacheMode(vfscommon.CacheModeOff)
+	assert.Equal(t, int64(93), cache.PinBudgetLeft())
+	f.mu.Lock()
+	f.o = original
+	f.mu.Unlock()
+	v.SetCacheMode(vfscommon.CacheModeFull)
+	v.warmWG.Wait()
+	assert.True(t, v.cache.Present("keep", int64(len("content"))))
+}
diff --git a/vfs/vfscache/pin.go b/vfs/vfscache/pin.go
new file mode 100644
index 000000000..a457d15eb
--- /dev/null
+++ b/vfs/vfscache/pin.go
@@ -0,0 +1,418 @@
+package vfscache
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"maps"
+	"os"
+	"path"
+	"strings"
+
+	"github.com/rclone/rclone/fs"
+)
+
+// PinState is the on-disk record of pin modes keyed by path
+type PinState struct {
+	Pins  map[string]PinMode `json:"pins"`
+	Sizes map[string]int64   `json:"sizes,omitempty"` // full sizes of admitted pinned files
+}
+
+// PinMode controls how the cache treats a path
+type PinMode string
+
+// PinMode options
+const (
+	PinModePinned   PinMode = "pinned"   // keep fully cached, never evict
+	PinModeUnpinned PinMode = "unpinned" // normal cache behaviour - stored only as an exception under a pinned parent
+)
+
+// loadPins reads the pin state from disk - a missing file means no pins
+func (c *Cache) loadPins() error {
+	data, err := os.ReadFile(c.pinsPath())
+	if errors.Is(err, os.ErrNotExist) {
+		c.pins.Pins = map[string]PinMode{}
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if err = json.Unmarshal(data, &c.pins); err != nil {
+		return err
+	}
+	if c.pins.Pins == nil {
+		c.pins.Pins = map[string]PinMode{}
+	}
+	return nil
+}
+
+// clonePins snapshots the policy and its budget, with c.mu held.
+func (c *Cache) clonePins() PinState {
+	return PinState{Pins: maps.Clone(c.pins.Pins), Sizes: maps.Clone(c.pins.Sizes)}
+}
+
+// savePins writes the pin state atomically, restoring previous on failure
+//
+// call with c.mu held
+func (c *Cache) savePins(previous PinState) (err error) {
+	defer func() {
+		if err != nil {
+			c.pins = previous
+		}
+	}()
+	for name := range c.pins.Sizes {
+		if c._pinMode(name) != PinModePinned {
+			delete(c.pins.Sizes, name)
+		}
+	}
+	data, err := json.Marshal(c.pins)
+	if err != nil {
+		return err
+	}
+	tmp := c.pinsPath() + ".tmp"
+	if err = os.WriteFile(tmp, data, 0600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, c.pinsPath())
+}
+
+// pinsPath is beside metaRoot rather than inside it as metaRoot can be purged
+func (c *Cache) pinsPath() string {
+	return c.metaRoot + ".pins.json"
+}
+
+// SetPin sets the pin mode for name and saves it to disk, replacing
+// any entries below name
+func (c *Cache) SetPin(name string, mode PinMode) error {
+	name = clean(name)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	previous := c.clonePins()
+
+	if mode == PinModeUnpinned {
+		c._unpin(name)
+	} else {
+		c._clearBelow(name)
+		c.pins.Pins[name] = mode
+	}
+	if err := c.savePins(previous); err != nil {
+		return err
+	}
+	if mode == PinModePinned {
+		c._forgetCold(name)
+	}
+	return nil
+}
+
+// _unpin removes the entries for name and below, storing PinModeUnpinned
+// as an exception if name would still be pinned via a parent
+//
+// call with c.mu held
+func (c *Cache) _unpin(name string) {
+	c._clearBelow(name)
+	delete(c.pins.Pins, name)
+	if c._pinMode(name) == PinModePinned {
+		c.pins.Pins[name] = PinModeUnpinned
+	}
+}
+
+// _clearBelow removes the entries for everything below name so an
+// action on a directory applies to all of it
+//
+// call with c.mu held
+func (c *Cache) _clearBelow(name string) {
+	for entry := range c.pins.Pins {
+		if name == "" || strings.HasPrefix(entry, name+"/") {
+			delete(c.pins.Pins, entry)
+		}
+	}
+}
+
+// _pinMode returns the mode for name, inherited from the nearest
+// parent with an entry, or PinModeUnpinned if none
+//
+// call with c.mu held
+func (c *Cache) _pinMode(name string) PinMode {
+	name = clean(name)
+	for {
+		mode, ok := c.pins.Pins[name]
+		if ok {
+			return mode
+		}
+		if name == "" {
+			return PinModeUnpinned
+		}
+		name = clean(path.Dir(name))
+	}
+}
+
+// PinMode returns the effective pin mode for name
+func (c *Cache) PinMode(name string) PinMode {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c._pinMode(name)
+}
+
+// Present returns true if name is fully cached at the given size
+func (c *Cache) Present(name string, size int64) bool {
+	c.mu.Lock()
+	item, ok := c.item[clean(name)]
+	c.mu.Unlock()
+	if !ok {
+		return false
+	}
+	item.mu.Lock()
+	defer item.mu.Unlock()
+	return item.info.Size == size && item._present()
+}
+
+// Mixed returns true if any entry below name sets a different mode to
+// name itself
+func (c *Cache) Mixed(name string) bool {
+	name = clean(name)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	mode := c._pinMode(name)
+	for entry, entryMode := range c.pins.Pins {
+		if (name == "" || strings.HasPrefix(entry, name+"/")) && entryMode != mode {
+			return true
+		}
+	}
+	return false
+}
+
+// PinnedPaths returns a copy of all paths set to PinModePinned
+func (c *Cache) PinnedPaths() []string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	var paths []string
+
+	for name, mode := range c.pins.Pins {
+		if mode == PinModePinned {
+			paths = append(paths, name)
+		}
+	}
+	return paths
+}
+
+// Evict unpins name and removes its cached data, or the cached data of
+// everything under it if it is a directory
+//
+// Pins below name are removed too. Items which are open, dirty or in
+// their handle caching grace period are skipped, returned, and evicted
+// by the cache cleaner once they are free.
+func (c *Cache) Evict(name string) (skipped []string, err error) {
+	name = clean(name)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	previous := c.clonePins()
+
+	c._unpin(name)
+	if err := c.savePins(previous); err != nil {
+		return nil, err
+	}
+	skipped = c._evict(name)
+	if c.coldPending == nil {
+		c.coldPending = map[string]bool{}
+	}
+	for _, itemName := range skipped {
+		c.coldPending[itemName] = true
+	}
+	return skipped, nil
+}
+
+// Releasing returns true if name is waiting to be evicted by Evict
+func (c *Cache) Releasing(name string) bool {
+	name = clean(name)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	_, cached := c.item[name]
+	return cached && c.coldPending[name] && c._pinMode(name) != PinModePinned
+}
+
+// _forgetCold cancels pending evictions at or under name
+//
+// call with c.mu held
+func (c *Cache) _forgetCold(name string) {
+	for entry := range c.coldPending {
+		if name == "" || entry == name || strings.HasPrefix(entry, name+"/") {
+			delete(c.coldPending, entry)
+		}
+	}
+}
+
+// _evict removes the cached data for items at or under name, returning
+// the ones it could not remove
+//
+// call with c.mu held
+func (c *Cache) _evict(name string) (skipped []string) {
+	for itemName, item := range c.item {
+		if name != "" && itemName != name && !strings.HasPrefix(itemName, name+"/") {
+			continue
+		}
+		if c._pinMode(itemName) == PinModePinned {
+			continue
+		}
+		c.removeNotInUse(item, 0, false)
+		if _, ok := c.item[itemName]; ok {
+			skipped = append(skipped, itemName)
+		}
+	}
+	return skipped
+}
+
+// hasPinEntries reports whether name has saved policy or size entries, with c.mu held.
+func (c *Cache) hasPinEntries(name string) bool {
+	for entry := range c.pins.Pins {
+		if name == "" || entry == name || strings.HasPrefix(entry, name+"/") {
+			return true
+		}
+	}
+	for entry := range c.pins.Sizes {
+		if name == "" || entry == name || strings.HasPrefix(entry, name+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+// RenamePins moves the entries for name and below to newName.
+func (c *Cache) RenamePins(name, newName string) error {
+	name, newName = clean(name), clean(newName)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.hasPinEntries(name) {
+		return nil
+	}
+	previous := c.clonePins()
+	for entry, mode := range previous.Pins {
+		if entry == name || strings.HasPrefix(entry, name+"/") {
+			delete(c.pins.Pins, entry)
+			c.pins.Pins[newName+entry[len(name):]] = mode
+		}
+	}
+	for entry, size := range previous.Sizes {
+		if entry == name || strings.HasPrefix(entry, name+"/") {
+			delete(c.pins.Sizes, entry)
+			c.pins.Sizes[newName+entry[len(name):]] = size
+		}
+	}
+	return c.savePins(previous)
+}
+
+// RemovePins removes the entries for name and below.
+func (c *Cache) RemovePins(name string) error {
+	name = clean(name)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.hasPinEntries(name) {
+		return nil
+	}
+	previous := c.clonePins()
+	c._clearBelow(name)
+	delete(c.pins.Pins, name)
+	for entry := range c.pins.Sizes {
+		if name == "" || entry == name || strings.HasPrefix(entry, name+"/") {
+			delete(c.pins.Sizes, entry)
+		}
+	}
+	return c.savePins(previous)
+}
+
+// PinBudgetLeft returns how many more bytes can be pinned, or -1 if
+// --vfs-cache-max-size is not set
+func (c *Cache) PinBudgetLeft() int64 {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c._pinBudgetLeft()
+}
+
+// _pinBudgetLeft counts each admitted pinned file once, including failed downloads.
+//
+// call with c.mu held
+func (c *Cache) _pinBudgetLeft() int64 {
+	limit := int64(c.opt.CacheMaxSize)
+	if limit <= 0 {
+		return -1
+	}
+	return max(0, limit-c._pinBytes(nil))
+}
+
+// _pinBytes counts admitted and cached pinned bytes, including an optional new batch.
+//
+// call with c.mu held
+func (c *Cache) _pinBytes(extra map[string]int64) int64 {
+	sizes := make(map[string]int64, len(c.pins.Sizes)+len(extra))
+	maps.Copy(sizes, c.pins.Sizes)
+	maps.Copy(sizes, extra)
+	for name, item := range c.item {
+		if c._pinMode(name) == PinModePinned {
+			item.mu.Lock()
+			sizes[name] = max(sizes[name], item.info.Rs.Size())
+			item.mu.Unlock()
+		}
+	}
+	var used int64
+	for _, size := range sizes {
+		used += size
+	}
+	return used
+}
+
+// PinReserve pins names and saves the full size of each file in sizes until unpinned.
+// Budget and persistence checks also apply to retries (an empty names list).
+// If either check fails, no pins or sizes change.
+func (c *Cache) PinReserve(names []string, sizes map[string]int64) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	files := make(map[string]int64, len(sizes))
+	for name, size := range sizes {
+		name = clean(name)
+		if len(names) > 0 || c._pinMode(name) == PinModePinned {
+			files[name] = max(files[name], size)
+		}
+	}
+	if used, limit := c._pinBytes(files), int64(c.opt.CacheMaxSize); limit > 0 && used > limit {
+		return fmt.Errorf("pinning would use %v, exceeding --vfs-cache-max-size of %v", fs.SizeSuffix(used), fs.SizeSuffix(limit))
+	}
+	previous := c.clonePins()
+	for _, name := range names {
+		name = clean(name)
+		c._clearBelow(name)
+		c.pins.Pins[name] = PinModePinned
+	}
+	if c.pins.Sizes == nil {
+		c.pins.Sizes = map[string]int64{}
+	}
+	maps.Copy(c.pins.Sizes, files)
+	if err := c.savePins(previous); err != nil {
+		return err
+	}
+	for _, name := range names {
+		c._forgetCold(clean(name))
+	}
+	return nil
+}
+
+// SetPinFailed records whether the last warm of name failed
+func (c *Cache) SetPinFailed(name string, failed bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.pinFailed == nil {
+		c.pinFailed = map[string]bool{}
+	}
+	if failed {
+		c.pinFailed[clean(name)] = true
+	} else {
+		delete(c.pinFailed, clean(name))
+	}
+}
+
+// PinFailed returns true if the last warm of name failed
+func (c *Cache) PinFailed(name string) bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.pinFailed[clean(name)]
+}
diff --git a/vfs/vfscache/pin_test.go b/vfs/vfscache/pin_test.go
new file mode 100644
index 000000000..1dfe3e84e
--- /dev/null
+++ b/vfs/vfscache/pin_test.go
@@ -0,0 +1,340 @@
+package vfscache
+
+import (
+	"os"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/lib/ranges"
+	"github.com/rclone/rclone/vfs/vfscommon"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPinSurvivesPurge(t *testing.T) {
+	_, c := newTestCache(t)
+
+	potato := c.Item("sub/dir/potato")
+	require.NoError(t, potato.Open(nil))
+	require.NoError(t, potato.Close(nil))
+
+	potato2 := c.Item("sub/dir2/potato2")
+	require.NoError(t, potato2.Open(nil))
+	require.NoError(t, potato2.Close(nil))
+
+	require.NoError(t, c.SetPin("sub/dir", PinModePinned))
+	c.purgeOld(-10 * time.Second)
+
+	assert.Equal(t, []string{
+		`name="sub/dir/potato" opens=0 size=0`,
+	}, itemAsString(c))
+}
+
+func TestEvict(t *testing.T) {
+	_, c := newTestCache(t)
+
+	for _, name := range []string{"sub/dir/potato", "sub/dir/keep/potato3", "sub/dir2/potato2"} {
+		item := c.Item(name)
+		require.NoError(t, item.Open(nil))
+		require.NoError(t, item.Close(nil))
+	}
+	require.NoError(t, c.SetPin("sub/dir", PinModePinned))
+	require.NoError(t, c.SetPin("sub/dir/keep", PinModePinned))
+
+	skipped, err := c.Evict("sub/dir")
+	require.NoError(t, err)
+	assert.Empty(t, skipped)
+
+	assert.Equal(t, []string{
+		`name="sub/dir2/potato2" opens=0 size=0`,
+	}, itemAsString(c))
+	assert.Empty(t, c.pins.Pins)
+}
+
+func TestSetPinUnpinned(t *testing.T) {
+	_, c := newTestCache(t)
+
+	require.NoError(t, c.SetPin("sub/dir", PinModePinned))
+	require.NoError(t, c.SetPin("sub/dir", PinModeUnpinned))
+	assert.Empty(t, c.pins.Pins)
+
+	require.NoError(t, c.SetPin("sub", PinModePinned))
+	require.NoError(t, c.SetPin("sub/dir", PinModeUnpinned))
+	assert.Equal(t, map[string]PinMode{"sub": PinModePinned, "sub/dir": PinModeUnpinned}, c.pins.Pins)
+	assert.Equal(t, PinModeUnpinned, c.PinMode("sub/dir/potato"))
+	assert.Equal(t, PinModePinned, c.PinMode("sub/other"))
+}
+
+func TestEvictUnderPinnedParent(t *testing.T) {
+	_, c := newTestCache(t)
+
+	for _, name := range []string{"sub/potato", "sub/potato2"} {
+		item := c.Item(name)
+		require.NoError(t, item.Open(nil))
+		require.NoError(t, item.Close(nil))
+	}
+	require.NoError(t, c.SetPin("sub", PinModePinned))
+
+	skipped, err := c.Evict("sub/potato")
+	require.NoError(t, err)
+	assert.Empty(t, skipped)
+
+	assert.Equal(t, []string{
+		`name="sub/potato2" opens=0 size=0`,
+	}, itemAsString(c))
+	assert.Equal(t, PinModeUnpinned, c.pins.Pins["sub/potato"])
+}
+
+func TestEvictPendingUntilFree(t *testing.T) {
+	opt := vfscommon.Opt
+	opt.CachePollInterval = 0
+	opt.WriteBack = 0
+	opt.HandleCaching = fs.Duration(100 * time.Millisecond)
+	_, c := newTestCacheOpt(t, opt)
+
+	potato := c.Item("sub/potato")
+	require.NoError(t, potato.Open(nil))
+	require.NoError(t, potato.Close(nil))
+
+	skipped, err := c.Evict("sub")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"sub/potato"}, skipped)
+	assert.True(t, c.Releasing("sub/potato"))
+
+	time.Sleep(300 * time.Millisecond)
+	c.purgeOld(time.Hour)
+	assert.Empty(t, itemAsString(c))
+	assert.False(t, c.Releasing("sub/potato"))
+}
+
+func TestPinCancelsPendingEvict(t *testing.T) {
+	opt := vfscommon.Opt
+	opt.CachePollInterval = 0
+	opt.WriteBack = 0
+	opt.HandleCaching = fs.Duration(100 * time.Millisecond)
+	_, c := newTestCacheOpt(t, opt)
+
+	potato := c.Item("sub/potato")
+	require.NoError(t, potato.Open(nil))
+	require.NoError(t, potato.Close(nil))
+
+	_, err := c.Evict("sub")
+	require.NoError(t, err)
+	require.NoError(t, c.SetPin("sub", PinModePinned))
+	require.NoError(t, c.SetPin("sub", PinModeUnpinned))
+	assert.False(t, c.Releasing("sub/potato"))
+
+	time.Sleep(300 * time.Millisecond)
+	c.purgeOld(time.Hour)
+	assert.Len(t, itemAsString(c), 1)
+}
+
+func TestFolderActionClearsEntriesBelow(t *testing.T) {
+	_, c := newTestCache(t)
+
+	require.NoError(t, c.SetPin("sub", PinModePinned))
+	require.NoError(t, c.SetPin("sub/dir", PinModeUnpinned))
+	require.NoError(t, c.SetPin("sub", PinModeUnpinned))
+	assert.Empty(t, c.pins.Pins)
+
+	require.NoError(t, c.SetPin("sub/dir", PinModeUnpinned))
+	require.NoError(t, c.SetPin("sub/dir/potato", PinModePinned))
+	require.NoError(t, c.SetPin("sub", PinModePinned))
+	assert.Equal(t, map[string]PinMode{"sub": PinModePinned}, c.pins.Pins)
+}
+
+func TestMixed(t *testing.T) {
+	_, c := newTestCache(t)
+
+	require.NoError(t, c.SetPin("sub", PinModePinned))
+	assert.False(t, c.Mixed("sub"))
+	assert.False(t, c.Mixed("other"))
+
+	require.NoError(t, c.SetPin("sub/dir/potato", PinModeUnpinned))
+	assert.True(t, c.Mixed("sub"))
+	assert.True(t, c.Mixed("sub/dir"))
+	assert.False(t, c.Mixed("sub/other"))
+	assert.True(t, c.Mixed(""))
+}
+
+func TestRenameAndRemovePins(t *testing.T) {
+	_, c := newTestCache(t)
+
+	require.NoError(t, c.SetPin("sub", PinModePinned))
+	require.NoError(t, c.SetPin("sub/dir/potato", PinModeUnpinned))
+	require.NoError(t, c.SetPin("subway", PinModePinned))
+
+	require.NoError(t, c.RenamePins("sub", "moved/sub"))
+	assert.Equal(t, map[string]PinMode{
+		"moved/sub":            PinModePinned,
+		"moved/sub/dir/potato": PinModeUnpinned,
+		"subway":               PinModePinned,
+	}, c.pins.Pins)
+
+	require.NoError(t, c.RemovePins("moved"))
+	assert.Equal(t, map[string]PinMode{"subway": PinModePinned}, c.pins.Pins)
+}
+
+func TestPinReserve(t *testing.T) {
+	opt := vfscommon.Opt
+	opt.CachePollInterval = 0
+	opt.WriteBack = 0
+	opt.HandleCaching = 0
+	opt.CacheMaxSize = 100
+	_, c := newTestCacheOpt(t, opt)
+
+	err := c.PinReserve([]string{"sub/dir"}, map[string]int64{"sub/dir/file": 60})
+	require.NoError(t, err)
+	assert.Equal(t, int64(40), c.PinBudgetLeft())
+
+	err = c.PinReserve([]string{"sub/dir2", "other"}, map[string]int64{"other": 60})
+	assert.Error(t, err)
+	assert.Equal(t, map[string]PinMode{"sub/dir": PinModePinned}, c.pins.Pins)
+	assert.Equal(t, int64(40), c.PinBudgetLeft())
+}
