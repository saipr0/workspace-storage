+	c.SetPinFailed("a", true)
+	assert.Equal(t, int64(40), c.PinBudgetLeft())
+	c.pins = PinState{} // reload without retaining any in-memory budget
+	require.NoError(t, c.loadPins())
+	assert.Equal(t, int64(40), c.PinBudgetLeft())
+	err = c.PinReserve([]string{"b"}, map[string]int64{"b": 50})
+	require.Error(t, err)
+	assert.Equal(t, PinModeUnpinned, c.PinMode("b"))
+}
