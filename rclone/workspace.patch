diff --git a/vfs/pin.go b/vfs/pin.go
new file mode 100644
index 000000000..d36c95263
--- /dev/null
+++ b/vfs/pin.go
@@ -0,0 +1,141 @@
+package vfs
+
+import (
+	"context"
+	"errors"
+	"io"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/vfs/vfscache"
+)
+
+// warmPinned warms every pinned path, resuming any warm interrupted by a restart
+func (vfs *VFS) warmPinned(ctx context.Context, cache *vfscache.Cache) {
+	for _, name := range cache.PinnedPaths() {
+		if err := vfs.startWarm(ctx, cache, nil, []string{name}); err != nil {
+			fs.Errorf(name, "vfs pin: %v", err)
+		}
+	}
+}
+
+// pinAndWarm reserves the space needed for names, pins newNames and
+// starts warming names in the background
+func (vfs *VFS) pinAndWarm(newNames, names []string) error {
+	vfs.warmMu.Lock()
+	defer vfs.warmMu.Unlock()
+	if vfs.cache == nil {
+		return errors.New("VFS cache is disabled")
+	}
+	return vfs.startWarm(vfs.warmCtx, vfs.cache, newNames, names)
+}
+
+// startWarm runs while warmMu is held or an existing warmer keeps warmWG nonzero.
+func (vfs *VFS) startWarm(ctx context.Context, cache *vfscache.Cache, newNames, names []string) error {
+	sizes := map[string]int64{}
+	for _, name := range names {
+		if err := vfs.pinSizes(ctx, name, sizes); err != nil {
+			return err
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if err := cache.PinReserve(newNames, sizes); err != nil {
+		return err
+	}
+	vfs.warmWG.Add(1)
+	go func() {
+		defer vfs.warmWG.Done()
+		for _, name := range names {
+			if err := vfs.warm(ctx, cache, name); err != nil {
+				fs.Errorf(name, "vfs pin: warm failed: %v", err)
+			}
+		}
+	}()
+	return nil
+}
+
+// pinSizes collects full file sizes, deduplicating overlapping paths.
+func (vfs *VFS) pinSizes(ctx context.Context, name string, sizes map[string]int64) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	node, err := vfs.Stat(name)
+	if err != nil {
+		return err
+	}
+	if !node.IsDir() {
+		sizes[node.Path()] = node.Size()
+		return nil
+	}
+	children, err := node.(*Dir).ReadDirAll()
+	if err != nil {
+		return err
+	}
+	for _, child := range children {
+		if err := vfs.pinSizes(ctx, child.Path(), sizes); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// warm reads name through the VFS so the full cache stores every
+// byte - directories are walked recursively, skipping anything not pinned
+// and carrying on past files which fail
+func (vfs *VFS) warm(ctx context.Context, cache *vfscache.Cache, name string) (err error) {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if cache.PinMode(name) != vfscache.PinModePinned {
+		return nil
+	}
+	node, err := vfs.Stat(name)
+	if err != nil {
+		return err
+	}
+
+	if node.IsDir() {
+		dir := node.(*Dir)
+		children, err := dir.ReadDirAll()
+		if err != nil {
+			return err
+		}
+
+		for _, child := range children {
+			if err := vfs.warm(ctx, cache, child.Path()); err != nil {
+				fs.Errorf(child.Path(), "vfs pin: warm failed: %v", err)
+			}
+		}
+		return nil
+	}
+
+	if cache.Present(name, node.Size()) {
+		return nil
+	}
+	defer func() { cache.SetPinFailed(name, err != nil) }()
+	f, err := vfs.Open(name)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+
+	// Read in chunks so unpinning or making it cold stops the download.
+	for {
+		if err = ctx.Err(); err != nil {
+			return err
+		}
+		if cache.PinMode(name) != vfscache.PinModePinned {
+			return nil
+		}
+		if _, err = io.CopyN(io.Discard, f, 4<<20); errors.Is(err, io.EOF) {
+			break
+		} else if err != nil {
+			return err
+		}
+	}
+	if !cache.Present(name, node.Size()) {
+		return errors.New("download incomplete")
+	}
+	return nil
+}
