+
+`, "|", "`") + getVFSHelp,
+		Fn: rcPin,
+	})
+}
+
+func rcPin(ctx context.Context, in rc.Params) (out rc.Params, err error) {
+	vfs, err := getVFS(in)
+	if err != nil {
+		return nil, err
+	}
+	if vfs.cache == nil {
+		return nil, rc.NewErrParamInvalid(errors.New("can't call this unless using the VFS cache"))
+	}
+
+	var paths []string
+	path, err := in.GetString("path")
+	if err == nil {
+		paths = []string{path}
+	} else if !rc.IsErrParamNotFound(err) {
+		return nil, err
+	}
+	if err := in.GetStructMissingOK("paths", &paths); err != nil {
+		return nil, err
+	}
+	if len(paths) == 0 {
+		return nil, rc.NewErrParamInvalid(errors.New("need path or paths"))
+	}
+	mode, err := in.GetString("mode")
+	if err != nil {
+		return nil, err
+	}
+
+	switch vfscache.PinMode(mode) {
+	case vfscache.PinModePinned:
+		return nil, vfs.pinAndWarm(paths, paths)
+	case vfscache.PinModeUnpinned:
+		for _, path := range paths {
+			if err := vfs.cache.SetPin(path, vfscache.PinModeUnpinned); err != nil {
+				return nil, err
+			}
+		}
+		return nil, nil
+	}
+	return nil, rc.NewErrParamInvalid(fmt.Errorf("unknown mode %q", mode))
+}
